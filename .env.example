# ==========================
# Stone TEF - Configuração
# ==========================

# Porta do servidor HTTP
PORT=3000

# ---- Credenciais Stone ----
# Secret Key (sk_*) — gerar em: Stone Portal > Perfil > Chaves de Autenticação
STONE_SECRET_KEY=sua_secret_key_aqui

# StoneCode do estabelecimento
STONE_CODE=seu_stone_code

# Serial da maquininha (opcional — se vazio, envia para todas as maquininhas vinculadas)
DEVICE_SERIAL=

# ---- Timeout ----
# Tempo máximo (ms) para aguardar pagamento na pinpad (padrão: 120000 = 2 min)
PAYMENT_TIMEOUT_MS=120000

# ---- Log ----
LOG_LEVEL=info
