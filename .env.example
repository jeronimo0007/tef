# ==========================
# Stone TEF - Configuração
# ==========================

# Modo de integração: "ffi" (DPOSDRV DLL/SO) ou "file" (Troca de Arquivos)
TEF_MODE=ffi

# Porta do servidor HTTP
PORT=3000

# ---- Credenciais Stone ----
STONE_CODE=SEU_STONE_CODE
CNPJ=SEU_CNPJ
EMPRESA=01
LOJA=0001
PDV=001

# ---- FFI Mode (DPOSDRV) ----
# Caminho para a DLL/SO do Stone TEF Client
# Windows: C:\DPOS\Bin\DPOSDRV.DLL
# Linux:   /opt/stone/lib/libdposdrv.so
DPOSDRV_PATH=C:\DPOS\Bin\DPOSDRV.DLL

# ---- File Exchange Mode (Troca de Arquivos) ----
# Diretório onde o Gerenciador Padrão lê os arquivos de requisição
TEF_REQ_DIR=C:\Cliente\Req
# Diretório onde o Gerenciador Padrão escreve os arquivos de resposta
TEF_RESP_DIR=C:\Cliente\Resp
# Caminho do executável do Gerenciador Padrão
TEF_GP_PATH=C:\TEFStone\GP.exe

# ---- Log ----
LOG_LEVEL=info
